{
  "name": "docx-to-html-conv",
  "version": "1.0.2",
  "description": "Convert Word (.docx) documents to paginated, self-contained HTML files (Node.js port of the C# DocxToHtml tool).",
  "keywords": [
    "docx",
    "word",
    "html",
    "ooxml",
    "converter"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "module": "./esm/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "esm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "fflate": "^0.8.3"
  },
  "bin": {
    "docx-to-html-conv": "./bin/cli.js"
  }
}
